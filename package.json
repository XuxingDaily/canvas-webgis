{
  "name": "nav-map-sys-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @zhaolong/navigation",
    "build": "npm run build --workspace @zhaolong/canvas-webgis && npm run build --workspace @zhaolong/navigation",
    "build:webgis": "npm run build --workspace @zhaolong/canvas-webgis",
    "build:navigation": "npm run build --workspace @zhaolong/navigation",
    "preview": "npm run preview --workspace @zhaolong/navigation",
    "test": "npm run test:watch --workspace @zhaolong/canvas-webgis",
    "test:run": "npm run test --workspace @zhaolong/canvas-webgis",
    "bench:spatial": "npm run bench:spatial --workspace @zhaolong/canvas-webgis",
    "bench:render": "npm run bench:render --workspace @zhaolong/canvas-webgis",
    "docs": "npm run docs --workspace @zhaolong/canvas-webgis",
    "docs:check": "npm run docs:check --workspace @zhaolong/canvas-webgis"
  }
}
